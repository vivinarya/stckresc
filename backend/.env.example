# =============================================================================
# StockRescue Backend Environment Configuration (.env.example)
# =============================================================================

# ASI:One Developer API (LLM Orchestration)
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1-mini

# ElevenLabs Voice Agent & Telephony
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
VOICE_PROVIDER=simulated
REAL_TELEPHONY_ENABLED=false
VOICE_ALLOWED_DESTINATIONS=
VOICE_MAX_CALL_DURATION_SECONDS=300
VOICE_MAX_CALLS_PER_CASE=3

# Twilio Telephony (SMS / Calling fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Langfuse Observability & Tracing
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# Warehouse FastAPI Service & Networking
APP_ENV=development
STOCKRESCUE_ENV=development
WAREHOUSE_API_HOST=127.0.0.1
WAREHOUSE_API_PORT=8000
DEMO_MODE=true
REAL_PURCHASING_ENABLED=false
WAREHOUSE_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BODY_BYTES=1048576

# =============================================================================
# Agentverse Access Controls & Consolidated 8-Identity Configuration
# =============================================================================
# Agentverse Basic plan allows exactly 8 external-agent mailbox identities.
# All 9 specialist tasks are preserved; 2 pairs share physical mailbox identities:
#   1. Coordinator
#   2. Inventory/BOM
#   3. Job Impact
#   4. Supplier Sourcing: Supplier Discovery + Compatibility (shared mailbox)
#   5. Quote & Planning:  Quote Risk + Recovery Planner (shared mailbox)
#   6. Procurement
#   7. Vendor Communication
#   8. Delivery Watch
#
# Access controls (comma-separated agent addresses, fail-closed when empty, '*' allowed for chat)
AGENTVERSE_CHAT_ALLOWED_SENDERS=*
AGENTVERSE_SPECIALIST_ALLOWED_SENDERS=

# Agentverse uAgents addresses (agent1... 65 characters)
AGENTVERSE_COORDINATOR_ADDRESS=
AGENTVERSE_INVENTORY_BOM_ADDRESS=
AGENTVERSE_JOB_IMPACT_ADDRESS=
# Shared Mailbox 1 (Supplier Sourcing: Discovery + Compatibility)
AGENTVERSE_SUPPLIER_DISCOVERY_ADDRESS=
AGENTVERSE_COMPATIBILITY_ADDRESS=  # Set to same value as AGENTVERSE_SUPPLIER_DISCOVERY_ADDRESS
# Shared Mailbox 2 (Quote & Planning: Quote Risk + Recovery Planner)
AGENTVERSE_QUOTE_RISK_ADDRESS=
AGENTVERSE_RECOVERY_PLANNER_ADDRESS=  # Set to same value as AGENTVERSE_QUOTE_RISK_ADDRESS
# Remaining independent specialist mailboxes
AGENTVERSE_PROCUREMENT_ADDRESS=
AGENTVERSE_VENDOR_VOICE_ADDRESS=
AGENTVERSE_DELIVERY_WATCH_ADDRESS=

# Agentverse seeds (16-256 printable characters) for the 8 active mailboxes
AGENTVERSE_SEED_COORDINATOR=your_generated_seed_goes_here
AGENTVERSE_SEED_INVENTORY_BOM=
AGENTVERSE_SEED_JOB_IMPACT=
AGENTVERSE_SEED_SUPPLIER_DISCOVERY=  # Serves both supplier_discovery and compatibility
AGENTVERSE_SEED_QUOTE_RISK=          # Serves both quote_risk and recovery_planner
AGENTVERSE_SEED_PROCUREMENT=
AGENTVERSE_SEED_VENDOR_VOICE=
AGENTVERSE_SEED_DELIVERY_WATCH=

# Specialist execution mode: local (default) or agentverse
SPECIALIST_TRANSPORT_MODE=local
SPECIALIST_TIMEOUT_SECONDS=30.0
SPECIALIST_MAX_RETRIES=2

# Database & Persistence (sqlite or postgres)
DATABASE_BACKEND=sqlite
DATABASE_PATH=data/stockrescue.db
DATABASE_TIMEOUT_SECONDS=5.0
LANGGRAPH_CHECKPOINTS_ENABLED=false
LANGGRAPH_POSTGRES_URL=
WAREHOUSE_DATABASE_URL=
LANGGRAPH_DB_POOL_MAX_SIZE=4

# Supabase Authentication & RBAC
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_JWT_ISSUER=https://<your-project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,HS256
SUPABASE_JWT_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_CACHE_SECONDS=300
SUPABASE_JWKS_TIMEOUT_SECONDS=5.0

# Skyfire Agentic Payment & Monetization (Seller Role)
SELLER_SKYFIRE_API_KEY=
SELLER_SERVICE_ID=stockrescue-premium-report
SELLER_ACCOUNT_ID=
SKYFIRE_ENV=sandbox
SKYFIRE_TOKENS_API_URL=https://api-sandbox.skyfire.xyz/v1